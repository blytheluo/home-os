page { height: 100vh; background: #f7f4ee; }
.ledger-scroll { height: calc(100vh - 88rpx); }
.ledger-page { padding: 34rpx 32rpx 180rpx; color: #3d352f; }
.ledger-intro { padding: 8rpx 4rpx 30rpx; }
.eyebrow,.section-kicker { display:block; color:#9b8d82; font-size:18rpx; letter-spacing:3rpx; }
.month-row { display:flex; align-items:center; justify-content:space-between; margin-top:12rpx; }
.page-title { font-size:44rpx; font-weight:600; }
.month-picker { padding:10rpx 16rpx; border-radius:18rpx; background:#ead9c7; color:#795d48; font-size:21rpx; }
.page-subtitle { display:block; margin-top:12rpx; color:#8f847b; font-size:24rpx; }
.ledger-summary { padding:28rpx 30rpx; border-radius:24rpx; background:#4d6f59; color:#fff; box-shadow:0 16rpx 34rpx rgba(77,111,89,.2); }
.summary-label { display:block; font-size:22rpx; opacity:.8; }.summary-amount { display:block; margin-top:8rpx; font-size:50rpx; font-weight:600; }.ledger-summary-divider { height:1rpx; margin:22rpx 0; background:rgba(255,255,255,.22); }.ledger-metrics { display:flex; }.ledger-metrics view { flex:1; }.ledger-metrics text { display:block; font-size:20rpx; opacity:.78; }.ledger-metrics text + text { margin-top:6rpx; font-size:25rpx; opacity:1; }.income-text { color:#f5d4a9; }.balance-text { color:#dce8df; }
.action-row { display:flex; align-items:center; margin-top:22rpx; padding:16rpx 20rpx; border-radius:16rpx; background:#fffdfa; }.import-button { margin:0; padding:0; background:transparent; color:#4d6f59; font-size:23rpx; line-height:1.5; }.import-button::after { border:none; }.action-note { margin-left:auto; color:#b0a39a; font-size:18rpx; }
.select-button { margin-left:18rpx; color:#9b623c; font-size:21rpx; }.selection-bar { display:flex; align-items:center; margin-top:12rpx; padding:16rpx 20rpx; border-radius:14rpx; background:#ead9c7; color:#795d48; font-size:21rpx; }.selection-count { margin-left:20rpx; color:#9b8d82; }.selection-delete { margin-left:auto; color:#b75d4d; }.ledger-item-selected { background:#f3eadf; }.select-check { display:flex; align-items:center; justify-content:center; width:34rpx; height:34rpx; margin-right:12rpx; border:2rpx solid #b9a28e; border-radius:8rpx; color:#fff; font-size:24rpx; }.ledger-item-selected .select-check { border-color:#4d6f59; background:#4d6f59; }
.list-heading { display:flex; align-items:flex-end; justify-content:space-between; margin:38rpx 4rpx 16rpx; }.section-title { display:block; margin-top:6rpx; font-size:30rpx; font-weight:600; }
.ledger-list { overflow:hidden; border-radius:20rpx; background:#fffdfa; box-shadow:0 6rpx 18rpx rgba(61,53,47,.06); }.ledger-item { display:flex; align-items:center; min-height:92rpx; padding:18rpx 20rpx; border-bottom:1rpx solid #f0ebe5; }.ledger-item:last-child { border-bottom:none; }.ledger-date { width:82rpx; color:#9b8d82; font-size:22rpx; }.ledger-copy { flex:1; min-width:0; }.ledger-title { display:block; overflow:hidden; font-size:25rpx; text-overflow:ellipsis; white-space:nowrap; }.ledger-note { display:block; margin-top:5rpx; color:#b0a39a; font-size:18rpx; }.important-mark { margin-left:6rpx; }.ledger-amount { width:138rpx; text-align:right; font-size:25rpx; font-weight:600; }.ledger-amount.expense { color:#3d352f; }.ledger-amount.income { color:#4d6f59; }.ledger-delete { width:34rpx; margin-left:10rpx; color:#c3b6ab; font-size:30rpx; text-align:right; }.empty { margin-top:100rpx; text-align:center; }.empty-title { display:block; color:#8f847b; font-size:27rpx; }.empty-sub { display:block; margin-top:10rpx; color:#b0a39a; font-size:21rpx; }.loading,.load-error { padding:40rpx; text-align:center; color:#9b8d82; }.load-error { color:#9b623c; }
.fab { position:fixed; right:34rpx; bottom:48rpx; z-index:10; display:flex; align-items:center; justify-content:center; width:104rpx; height:104rpx; border-radius:50%; background:#4d6f59; color:#fff; font-size:64rpx; font-weight:200; box-shadow:0 12rpx 24rpx rgba(77,111,89,.25); }
.mask { position:fixed; inset:0; z-index:20; background:rgba(61,53,47,.28); }.form-panel { position:fixed; left:0; right:0; bottom:0; z-index:21; max-height:82vh; overflow-y:auto; border-radius:26rpx 26rpx 0 0; background:#fffdfa; box-shadow:0 -8rpx 30rpx rgba(61,53,47,.12); }.form-header { display:flex; justify-content:space-between; padding:28rpx 32rpx 20rpx; }.form-title { font-size:30rpx; font-weight:600; }.form-close { color:#9b8d82; font-size:42rpx; line-height:30rpx; }.form-body { padding:0 32rpx 24rpx; }.form-item { margin-top:20rpx; }.form-label { display:block; margin-bottom:9rpx; color:#795d48; font-size:21rpx; }.form-input,.form-select,.form-textarea,.import-textarea { box-sizing:border-box; width:100%; padding:19rpx 20rpx; border-radius:14rpx; background:#f4efe8; color:#3d352f; font-size:24rpx; }.form-select { min-height:70rpx; }.form-row { display:flex; gap:16rpx; }.half { flex:1; }.important-switch { display:flex; align-items:center; gap:12rpx; margin-top:24rpx; color:#795d48; font-size:22rpx; }.check { display:flex; align-items:center; justify-content:center; width:34rpx; height:34rpx; border:2rpx solid #c9b9a9; border-radius:8rpx; color:#fff; }.check.checked { border-color:#4d6f59; background:#4d6f59; }.form-footer { padding:18rpx 32rpx 34rpx; border-top:1rpx solid #f0ebe5; }.form-submit { width:100%; border-radius:14rpx; background:#4d6f59; color:#fff; font-size:26rpx; }.form-submit::after { border:none; }.import-panel { max-height:68vh; }.import-help { display:block; color:#8f847b; font-size:21rpx; line-height:1.6; }.import-textarea { min-height:360rpx; margin-top:18rpx; line-height:1.8; }
