/**index.wxss**/
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #f7f4ee;
}

.scrollarea {
  flex: 1;
  overflow-y: hidden;
}

.page {
  padding: 28rpx 28rpx 220rpx;
}

/* ---- 预算看板 ---- */
.summary-card {
  background: #4d6f59;
  border-radius: 24rpx;
  padding: 30rpx;
  color: #ffffff;
  box-shadow: 0 16rpx 34rpx rgba(77, 111, 89, 0.2);
}

.summary-main {
  display: flex;
  flex-direction: column;
}

.summary-label {
  font-size: 24rpx;
  opacity: 0.85;
}

.summary-amount {
  margin-top: 6rpx;
  font-size: 48rpx;
  font-weight: 600;
  line-height: 1.2;
}

.over-budget {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #ffd6a8;
  background: rgba(255, 77, 79, 0.2);
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  align-self: flex-start;
}

.summary-divider {
  height: 1rpx;
  background: rgba(255, 255, 255, 0.2);
  margin: 20rpx 0;
}

.summary-progress {
  display: flex;
  align-items: center;
}

.summary-progress-label {
  font-size: 22rpx;
  opacity: 0.85;
  margin-right: 16rpx;
  white-space: nowrap;
}

.progress-track {
  flex: 1;
  height: 12rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-bar {
  height: 100%;
  background: #b8f0d0;
  border-radius: 6rpx;
  transition: width 0.3s;
}

.summary-progress-num {
  margin-left: 16rpx;
  font-size: 22rpx;
  opacity: 0.9;
  white-space: nowrap;
}

.summary-cat-budget {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.2);
  font-size: 20rpx;
  opacity: 0.75;
  line-height: 1.6;
}

.summary-sub {
  display: flex;
}

.summary-item {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.summary-item-label {
  font-size: 22rpx;
  opacity: 0.85;
}

.summary-item-value {
  margin-top: 6rpx;
  font-size: 30rpx;
  font-weight: 500;
}

.summary-item-value.spent {
  color: #ffe1a8;
}

.summary-item-value.ok {
  color: #b8f0d0;
}

.summary-item-value.danger {
  color: #ffb3b3;
}

/* ---- Tab 切换 ---- */
.tabs {
  display: flex;
  margin: 24rpx 0 16rpx;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 8rpx;
}

.tab {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: #8f847b;
  padding: 16rpx 0;
  border-radius: 12rpx;
}

.tab-active {
  background: #dce8df;
  color: #4d6f59;
  font-weight: 600;
}

/* ---- 操作提示 ---- */
.hint-bar {
  font-size: 22rpx;
  color: #9b8d82;
  background: #fffdfa;
  border-radius: 14rpx;
  padding: 12rpx 18rpx;
  margin-bottom: 16rpx;
}

.load-error {
  font-size: 24rpx;
  color: #9b623c;
  background: #f6e7d7;
  border-radius: 12rpx;
  padding: 16rpx 18rpx;
  margin-bottom: 16rpx;
  text-align: center;
}

.category-filter {
  width: 100%;
  margin-bottom: 16rpx;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
}

.category-chip {
  flex-shrink: 0;
  margin: 0 12rpx 12rpx 0;
  padding: 10rpx 18rpx;
  border-radius: 24rpx;
  background: #fffdfa;
  color: #8f847b;
  font-size: 22rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.category-chip-active {
  background: #789681;
  color: #ffffff;
}

/* ---- 列表 ---- */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 64rpx 0;
}

.empty-title {
  font-size: 30rpx;
  color: #999999;
}

.empty-sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #bbbbbb;
}

.loading {
  text-align: center;
  color: #bbbbbb;
  font-size: 26rpx;
  padding: 60rpx 0;
}

/* ---- 分类预算占用汇总 ---- */
.cat-stats {
  background: #fffdfa;
  border-radius: 20rpx;
  padding: 4rpx 20rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 6rpx 18rpx rgba(61, 53, 47, 0.06);
}

.cat-stat {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0ebe5;
}

.cat-stat:last-child {
  border-bottom: none;
}

.cat-stat-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.cat-name {
  font-size: 25rpx;
  color: #3d352f;
  font-weight: 500;
}

.cat-limit {
  font-size: 22rpx;
  color: #9b8d82;
}

.cat-stat-body {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 8rpx;
}

.cat-cell {
  font-size: 20rpx;
  color: #9b8d82;
}

.cat-cell.ok {
  color: #4d6f59;
}

.cat-cell.danger {
  color: #b75d4d;
}

.item-card {
  background: #fffdfa;
  border-radius: 20rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 6rpx 18rpx rgba(61, 53, 47, 0.06);
}

.item-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.item-tags {
  display: flex;
  align-items: center;
}

.tag {
  font-size: 19rpx;
  padding: 4rpx 10rpx;
  border-radius: 8rpx;
  margin-right: 12rpx;
}

.tag-category {
  background: #e8eee9;
  color: #4d6f59;
}

.tag-type {
  background: #ead9c7;
  color: #795d48;
}

.item-status {
  font-size: 22rpx;
  color: #a87855;
  background: #f6e7d7;
  padding: 6rpx 14rpx;
  border-radius: 20rpx;
  border: 1rpx solid #a87855;
}

/* 事项状态配色 */
.item-status.status-pending {
  color: #a87855;
  background: #f6e7d7;
  border-color: #a87855;
}
.item-status.status-doing {
  color: #587b67;
  background: #e8eee9;
  border-color: #789681;
}
.item-status.status-done {
  color: #4d6f59;
  background: #dce8df;
  border-color: #789681;
}
.item-status.status-confirmed {
  color: #795d48;
  background: #ead9c7;
  border-color: #a87855;
}
.item-status.status-dropped {
  color: #999999;
  background: #f2f2f2;
  border-color: #cccccc;
}
/* 预算状态配色 */
.item-status.status-tobuy {
  color: #a87855;
  background: #f6e7d7;
  border-color: #a87855;
}
.item-status.status-bought {
  color: #4d6f59;
  background: #dce8df;
  border-color: #789681;
}

.item-title {
  margin-top: 12rpx;
  font-size: 28rpx;
  color: #3d352f;
  font-weight: 500;
}

.item-content {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #8f847b;
  line-height: 1.5;
}

/* 预算行 */
.budget-row {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
}

.budget-label {
  font-size: 22rpx;
  color: #999999;
  margin-right: 12rpx;
}

.budget-label.actual {
  margin-left: 32rpx;
}

.budget-amount {
  font-size: 27rpx;
  color: #3d352f;
  font-weight: 500;
}

.budget-amount.actual {
  color: #4d6f59;
}

.item-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #f0ebe5;
}

.item-owner {
  font-size: 22rpx;
  color: #9b8d82;
}

.item-delete {
  font-size: 24rpx;
  color: #b75d4d;
}

/* ---- 新增按钮 ---- */
.fab {
  position: fixed;
  right: 32rpx;
  bottom: 44rpx;
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  background: #4d6f59;
  color: #ffffff;
  font-size: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 24rpx rgba(77, 111, 89, 0.28);
  z-index: 100;
}

/* ---- 表单弹窗 ---- */
.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 200;
}

.form-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fffdfa;
  border-radius: 24rpx 24rpx 0 0;
  z-index: 201;
  max-height: 85vh;
  display: flex;
  flex-direction: column;
}

.form-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #f0ebe5;
}

.form-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #3d352f;
}

.form-close {
  font-size: 44rpx;
  color: #999999;
  padding: 0 8rpx;
}

.form-body {
  flex: 1;
  overflow-y: auto;
  padding: 8rpx 32rpx 32rpx;
}

.form-item {
  margin-top: 28rpx;
}

.form-label {
  display: block;
  font-size: 24rpx;
  color: #795d48;
  margin-bottom: 12rpx;
}

.form-input {
  height: 84rpx;
  background: #f4efe8;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #3d352f;
}

.form-textarea {
  width: 100%;
  min-height: 140rpx;
  background: #f4efe8;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #3d352f;
  box-sizing: border-box;
}

.form-picker {
  background: #f4efe8;
  border-radius: 12rpx;
}

.form-select {
  height: 84rpx;
  line-height: 84rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #3d352f;
}

.form-placeholder {
  color: #bbbbbb;
}

.form-row {
  display: flex;
  justify-content: space-between;
}

.form-item.half {
  width: 48%;
}

.form-footer {
  padding: 20rpx 32rpx 40rpx;
  border-top: 1rpx solid #f0ebe5;
}

.form-submit {
  background: #4d6f59;
  color: #ffffff;
  font-size: 30rpx;
  border-radius: 12rpx;
  border: none;
}

.form-submit[disabled],
.form-submit-disabled {
  background: #a9b9ae;
  color: #ffffff;
}
